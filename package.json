{
  "name": "pokemon-tabletop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "engine:build": "node scripts/build-engine.mjs",
    "dev": "npm run engine:build && concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run engine:build && tsc --noEmit && vite build",
    "test": "npm run engine:build && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@progress/pako-esm": "^1.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
